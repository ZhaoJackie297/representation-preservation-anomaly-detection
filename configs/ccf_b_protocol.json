{
  "target": "CCF-B",
  "r0_frozen_manuscript": "paper/manuscript.docx",
  "primary_method_candidate": "AdaGraph-SoftCLT",
  "seeds": [20261116, 20261117, 20261118, 20261119, 20261120, 20261121, 20261122, 20261123, 20261124, 20261125],
  "training": {
    "epochs": 10,
    "batch_size": 16,
    "output_dims": 64,
    "hidden_dims": 64,
    "depth": 5
  },
  "evaluation": {
    "k_grid": [5, 10, 20],
    "cooldown_days": 7,
    "correction": "Holm",
    "primary_endpoints": ["pr_auc", "event_recall_at_k10"],
    "direction_rule": "seed_averaged_effect_then_at_least_8_of_10_seeds_positive",
    "bootstrap_repetitions": 10000,
    "bootstrap_primary_unit": "user_cluster",
    "bootstrap_sensitivity_unit": "event",
    "primary_inference": "average_paired_effect_over_ten_seeds_then_user_cluster_bootstrap",
    "mechanism_non_inferiority": {
      "neighborhood_overlap_ci_lower": -0.02,
      "effective_rank_ci_lower": -0.5
    }
  },
  "adagraph": {
    "max_rounds": 2,
    "representation_source": "ema_teacher_stop_gradient",
    "ema_decay_grid": [0.99, 0.995, 0.999],
    "distance_normalization": "row_median",
    "support_selection": "top_m_of_profile_prior_times_exp_negative_raw_distance_over_tau",
    "trust_region_kl_max_grid": [0.01, 0.05, 0.1, 0.2],
    "tau_grid": [0.05, 0.1, 0.2, 0.5, 1.0],
    "beta_solution": "beta=lambda/(tau+lambda), bisection on KL constraint",
    "weight_formula": "P_m^beta * exp(-(1-beta)*d_tilde/tau), normalized",
    "entropy_role": "objective_regularizer_only",
    "graph_top_m_grid": [10, 20, 50],
    "controls": [
      "profile_only",
      "profile_only_equal_budget",
      "representation_only",
      "one_step_trust_region",
      "two_round_trust_region",
      "no_anchor_ablation",
      "no_ema_ablation",
      "no_trust_region_ablation",
      "hard_neighbor_ablation",
      "profile_permutation_graph",
      "fixed_graph_restart_control",
      "nnclr_nearest_neighbor",
      "incremental_false_negative_detection",
      "false_negative_cancellation",
      "degree_preserving_random"
    ],
    "collapse_early_stop": {
      "effective_rank_drop_fraction": 0.2,
      "isotropy_drop_fraction": 0.2,
      "edge_change_rate_max": 0.5
    },
    "posthoc_only_metrics": [
      "anomalous_user_normal_core_rate"
    ],
    "organization_reference_evaluation": {
      "source": "CERT LDAP",
      "labels_used_for_training": false,
      "primary_reference": "same_department_and_role",
      "secondary_reference": "same_department",
      "metric": "top10_reference_agreement",
      "profile_excludes_ldap_fields": true,
      "compared_models": ["A1", "A2", "A3", "A4", "A5a", "A5b", "A7"]
    }
  },
  "required_baselines": [
    "TS2Vec",
    "TNC",
    "TS-TCC",
    "OmniAnomaly",
    "DCdetector",
    "AnomalyTransformer",
    "NNCLR-style",
    "FNC-style",
    "iForest"
  ],
  "security_experiments": [
    "threat_model",
    "low_and_slow",
    "amplitude_direction_perturbation",
    "operational_budget",
    "incident_case_study"
  ],
  "dataset_roles": {
    "CERT r4.2": "development; hyperparameter selection inside training validation",
    "CERT r5.2": "external test; no retuning after r4.2",
    "CERT r6.2": "five-event pressure audit only",
    "SMD": "cross-type validation for scoring side",
    "PSM/SMAP/MSL": "scoring-side external validation and robustness only"
  },
  "training_budget": {
    "unit": "optimizer_step",
    "base_budget": "B",
    "A3_budget": "2B",
    "A4_budget": "3B",
    "equal_compute_control": "continuous fixed-profile training to matching B/2B/3B",
    "equal_schedule_control": "A1plus uses a continuous schedule over matching total steps",
    "restart_control": "three B rounds with weight continuation and optimizer resets; graph fixed",
    "stage_initialization": "weight_continuation_with_optimizer_reset",
    "lr_schedule": "stagewise_warmup_cosine; A1plus uses matched continuous warmup_cosine"
  },
  "confirmatory_comparisons": [
    "A4_vs_A1",
    "A4_vs_A1plus_3B",
    "A4_vs_A7",
    "A4_vs_A8b",
    "A4_vs_A9"
  ],
  "execution_batches": {
    "pilot": ["A1", "A1plus", "A3", "A5a", "A5b", "A7"],
    "second": ["A2", "A4", "A8a", "A8b", "A9", "A3_noAnchor", "A3_noEMA", "A3_noTrust", "A3_hard"],
    "third": ["deep_baselines", "SxA_cross", "statistics", "security"]
  },
  "exclusions": {
    "CERT r6.2": "pressure audit only; no significance tests",
    "CERT r1": "excluded until label and preprocessing audit passes",
    "SMD": "S series and detection baselines only"
  },
  "label_isolation": {
    "graph_updates_use_labels": false,
    "hyperparameter_selection_split": "training-internal validation",
    "test_events_for_model_selection": false,
    "posthoc_label_metrics_cannot_early_stop": true
  }
}

